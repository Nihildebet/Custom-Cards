-- Custom Gemini Monster (Pseudo-Continuous Trap Enabler)
local s,id=GetID()
function s.initial_effect(c)
    -- Inisialisasi Prosedur Gemini
    Gemini.AddProcedure(c)

    -- 1. Special Summon dari tangan dengan menaruh 1 Gemini dari tangan ke S/T Zone sebagai Continuous Trap
    local e1=Effect.CreateEffect(c)
    e1:SetDescription(aux.Stringid(id,0))
    e1:SetType(EFFECT_TYPE_FIELD)
    e1:SetCode(EFFECT_SPSUMMON_PROC)
    e1:SetProperty(EFFECT_FLAG_UNCOPYABLE)
    e1:SetRange(LOCATION_HAND)
    e1:SetCondition(s.hspcon)
    e1:SetOperation(s.hspop)
    c:RegisterEffect(e1)

    -- 2. Special Summon dirinya sendiri saat berada di S/T Zone sebagai Continuous Trap
    local e2=Effect.CreateEffect(c)
    e2:SetDescription(aux.Stringid(id,1))
    e2:SetCategory(CATEGORY_SPECIAL_SUMMON)
    e2:SetType(EFFECT_TYPE_QUICK_O)
    e2:SetCode(EVENT_FREE_CHAIN)
    e2:SetRange(LOCATION_SZONE)
    e2:SetHintTiming(0,TIMINGS_CHECK_MONSTER+TIMING_MAIN_END)
    e2:SetCondition(s.selfspcon)
    e2:SetTarget(s.selfsptg)
    e2:SetOperation(s.selfspop)
    c:RegisterEffect(e2)

    -- 3. Efek Gemini (Bounce 1 Continuous Trap -> Pindahkan 1 monster lawan ke S/T Zone)
    local e3=Effect.CreateEffect(c)
    e3:SetDescription(aux.Stringid(id,2))
    e3:SetCategory(CATEGORY_TOHAND)
    e3:SetType(EFFECT_TYPE_IGNITION)
    e3:SetProperty(EFFECT_FLAG_CARD_TARGET)
    e3:SetRange(LOCATION_MZONE)
    e3:SetCondition(Gemini.EffectStatusCondition)
    e3:SetTarget(s.geminitg)
    e3:SetOperation(s.geminiop)
    c:RegisterEffect(e3)
end

-- =========================================================
-- EFEK 1: Special Summon Prosedur dari Tangan
-- =========================================================
function s.gemini_hand_filter(c)
    return c:IsType(TYPE_GEMINI) and not c:IsForbidden()
end

function s.hspcon(e,c)
    if c==nil then return true end
    local tp=c:GetControler()
    return Duel.GetLocationCount(tp,LOCATION_MZONE)>0
        and Duel.GetLocationCount(tp,LOCATION_SZONE)>0
        and Duel.IsExistingMatchingCard(s.gemini_hand_filter,tp,LOCATION_HAND,0,1,c)
end

function s.hspop(e,tp,eg,ep,ev,re,r,rp,c)
    Duel.Hint(HINT_SELECTMSG,tp,HINTMSG_TOFIELD)
    local g=Duel.SelectMatchingCard(tp,s.gemini_hand_filter,tp,LOCATION_HAND,0,1,1,c)
    local tc=g:GetFirst()
    if tc then
        Duel.MoveToField(tc,tp,tp,LOCATION_SZONE,POS_FACEUP,true)
        
        -- Ubah status kartu menjadi Continuous Trap
        local e1=Effect.CreateEffect(c)
        e1:SetCode(EFFECT_CHANGE_TYPE)
        e1:SetType(EFFECT_TYPE_SINGLE)
        e1:SetProperty(EFFECT_FLAG_CANNOT_DISABLE)
        e1:SetValue(TYPE_TRAP+TYPE_CONTINUOUS)
        e1:SetReset(RESET_EVENT+RESETS_STANDARD-RESET_TURN_SET)
        tc:RegisterEffect(e1)
    end
end

-- =========================================================
-- EFEK 2: Special Summon dari S/T Zone
-- =========================================================
function s.selfspcon(e,tp,eg,ep,ev,re,r,rp)
    local c=e:GetHandler()
    return Duel.IsMainPhase() and c:IsContinuousTrap()
end

function s.selfsptg(e,tp,eg,ep,ev,re,r,rp,chk)
    local c=e:GetHandler()
    if chk==0 then
        return Duel.GetLocationCount(tp,LOCATION_MZONE)>0
            and c:IsCanBeSpecialSummoned(e,0,tp,false,false)
    end
    Duel.SetOperationInfo(0,CATEGORY_SPECIAL_SUMMON,c,1,0,0)
end

function s.selfspop(e,tp,eg,ep,ev,re,r,rp)
    local c=e:GetHandler()
    if c:IsRelateToEffect(e) then
        Duel.SpecialSummon(c,0,tp,tp,false,false,POS_FACEUP)
    end
end

-- =========================================================
-- EFEK 3: Efek Gemini
-- =========================================================
function s.self_trap_filter(c)
    return c:IsFaceup() and c:IsContinuousTrap() and c:IsAbleToHand()
end

function s.opp_monster_filter(c)
    return c:IsFaceup() and not c:IsForbidden()
end

function s.geminitg(e,tp,eg,ep,ev,re,r,rp,chk,chkc)
    if chkc then return chkc:IsLocation(LOCATION_SZONE) and chkc:IsControler(tp) and s.self_trap_filter(chkc) end
    if chk==0 then return Duel.IsExistingTarget(s.self_trap_filter,tp,LOCATION_SZONE,0,1,nil) end
    Duel.Hint(HINT_SELECTMSG,tp,HINTMSG_RTOHAND)
    local g=Duel.SelectTarget(tp,s.self_trap_filter,tp,LOCATION_SZONE,0,1,1,nil)
    Duel.SetOperationInfo(0,CATEGORY_TOHAND,g,1,0,0)
end

function s.geminiop(e,tp,eg,ep,ev,re,r,rp)
    local tc=Duel.GetFirstTarget()
    if tc and tc:IsRelateToEffect(e) and Duel.SendtoHand(tc,nil,REASON_EFFECT)>0 and tc:IsLocation(LOCATION_HAND) then
        if Duel.GetLocationCount(tp,LOCATION_SZONE)>0 
            and Duel.IsExistingMatchingCard(s.opp_monster_filter,tp,0,LOCATION_MZONE,1,nil)
            and Duel.SelectYesNo(tp,aux.Stringid(id,3)) then
            
            Duel.BreakEffect()
            Duel.Hint(HINT_SELECTMSG,tp,HINTMSG_TOFIELD)
            local sg=Duel.SelectMatchingCard(tp,s.opp_monster_filter,tp,0,LOCATION_MZONE,1,1,nil)
            local target_mon=sg:GetFirst()
            if target_mon then
                Duel.MoveToField(target_mon,tp,tp,LOCATION_SZONE,POS_FACEUP,true)
                
                local e1=Effect.CreateEffect(e:GetHandler())
                e1:SetCode(EFFECT_CHANGE_TYPE)
                e1:SetType(EFFECT_TYPE_SINGLE)
                e1:SetProperty(EFFECT_FLAG_CANNOT_DISABLE)
                e1:SetValue(TYPE_TRAP+TYPE_CONTINUOUS)
                e1:SetReset(RESET_EVENT+RESETS_STANDARD-RESET_TURN_SET)
                target_mon:RegisterEffect(e1)
            end
        end
    end
end
